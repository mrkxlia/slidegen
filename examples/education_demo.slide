slide prisma_flow
  kicker "システマティックレビュー"
  headline "文献の選定フロー"
  foot "各段階のrowsが除外理由のサイドボックスになる"
  col
    "n = 1,200"
    理由 "重複 n=300"
  col
    "n = 900"
    理由 "対象外テーマ n=400"
  col
    "n = 500"
    理由 "全文入手不可 n=50"
  col highlight
    "n = 450"

---

slide consort_flow
  kicker "臨床試験"
  headline "被験者フロー"
  foot "prisma_flowと同一実装・ラベル違いのみ"
  col
    "n = 300"
  col
    "n = 280"
    理由 "適格基準を満たさず n=20"
  col
    "n = 260"
    理由 "追跡不能 n=20"
  col highlight
    "n = 255"
