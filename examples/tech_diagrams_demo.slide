slide state_transition
  kicker "ワークフロー"
  headline "経費精算の状態遷移"
  states "差戻し" "下書き" "申請中" "承認済" "精算完了"
  foot "遷移線は矢頭なし・ラベルで意味を伝える（statesは頻出遷移が隣接する順で書く）"
  col
    from "下書き"
    to "申請中"
    "申請"
  col highlight
    from "申請中"
    to "承認済"
    "承認"
  col
    from "申請中"
    to "差戻し"
    "却下"
  col
    from "差戻し"
    to "下書き"
    "再編集"
  col
    from "承認済"
    to "精算完了"
    "振込"

