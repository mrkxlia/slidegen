# S5c: 技術資料10型の実証（code_diff / sql_result / sequence_diagram / state_transition /
# er_diagram / layered_stack / cloud_architecture / c4_context / slo_sli_table /
# incident_severity_table）。経費精算SaaSの技術資料を題材に10枚。

slide code_diff
  kicker "実装"
  headline "タイムアウト設定を追加"
  lang "diff — retry.py"
  foot "行頭 +/- で追加・削除を色分け"
  col
    "     def fetch_with_retry(url, n=3):"
    "         for i in range(n):"
    "-            return requests.get(url)"
    "+            return requests.get(url, timeout=5)"

---

slide sql_result
  kicker "分析"
  headline "アクティブユーザー数トップ5"
  query "SELECT user_id, count(*) AS cnt" "FROM events" "GROUP BY user_id" "ORDER BY cnt DESC LIMIT 5"
  foot "上=クエリ／下=結果テーブル"
  col "user_id"
    "1001"
    "1002"
    "1003"
  col "cnt"
    "42"
    "37"
    "29"

---

slide sequence_diagram
  kicker "処理フロー"
  headline "ログイン処理のシーケンス"
  participants "ユーザー" "API" "DB"
  foot "参加者=縦のライフライン、メッセージ=横向き矢印"
  col
    from "ユーザー"
    to "API"
    "ログイン要求"
  col highlight
    from "API"
    to "DB"
    "認証情報を照会"
  col
    from "DB"
    to "API"
    "認証結果"
  col
    from "API"
    to "ユーザー"
    "トークン発行"

