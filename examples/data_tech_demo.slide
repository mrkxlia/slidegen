slide code_block
  kicker "実装例"
  headline "リトライ処理の実装"
  lang "python — retry.py"
  col
    "def fetch_with_retry(url, n=3):"
    "    for i in range(n):"
    "        try:"
    "            return http.get(url)"
    "        except TimeoutError:"
    "            sleep(2 ** i)"
    "    raise RuntimeError('failed')"

