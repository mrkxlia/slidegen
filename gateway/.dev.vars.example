# gateway/.dev.vars — wrangler dev 用のローカルシークレット（このファイルはコピー元）。
# 使い方: このファイルを `.dev.vars` にコピーし、使うキーを記入する。
# `.dev.vars` は .gitignore 済み（コミットしないこと）。本番は `wrangler secret put` を使う。

# 無料テスト用（どれか1つあればローカル起動可。Gemini か OpenRouter が確実）
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# 本番プロバイダ（設定すると /api/models に本番モデルが出る）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Workers AI を binding 無し環境で REST 利用する場合のみ（通常はローカルでは不要）
# CF_ACCOUNT_ID=
# CF_AI_API_TOKEN=
